"""
Lambda Function 2: Transcribe Video using Whisper
Handles audio transcription with word-level timestamps
"""
import json
import boto3
import os
import shutil
import warnings

# Suppress harmless warnings in Lambda environment
warnings.filterwarnings('ignore', category=UserWarning, module='whisper')
warnings.filterwarnings('ignore', message='.*multiprocessing.*')

# Set cache directories to /tmp (only writable directory in Lambda)
os.environ['XDG_CACHE_HOME'] = '/tmp/.cache'
os.environ['TORCH_HOME'] = '/tmp/.torch'
os.environ['HF_HOME'] = '/tmp/.huggingface'

import whisper

# Storage helper - works with S3, R2, B2, and any S3-compatible storage
def get_storage_client():
    """Get S3-compatible storage client (supports AWS S3, Cloudflare R2, Backblaze B2, etc.)"""
    endpoint = os.environ.get('R2_ENDPOINT') or os.environ.get('STORAGE_ENDPOINT')
    access_key = os.environ.get('R2_ACCESS_KEY') or os.environ.get('AWS_ACCESS_KEY_ID')
    secret_key = os.environ.get('R2_SECRET_KEY') or os.environ.get('AWS_SECRET_ACCESS_KEY')

    if endpoint:
        print(f"[Storage] Using custom endpoint: {endpoint}")
        return boto3.client('s3',
            endpoint_url=endpoint,
            aws_access_key_id=access_key,
            aws_secret_access_key=secret_key,
            region_name=os.environ.get('AWS_REGION', 'auto')
        )
    print("[Storage] Using AWS S3 (default)")
    return boto3.client('s3')

s3 = get_storage_client()
BUCKET_NAME = os.environ.get('BUCKET_NAME', 'opus-clip-videos')

# Load Whisper model once (reused across warm invocations)
model = None
MODEL_SIZE = os.environ.get('WHISPER_MODEL', 'base')

def get_disk_usage():
    """Get disk usage of /tmp directory"""
    stat = shutil.disk_usage('/tmp')
    return {
        'total_gb': stat.total / (1024**3),
        'used_gb': stat.used / (1024**3),
        'free_gb': stat.free / (1024**3),
        'percent_used': (stat.used / stat.total) * 100
    }

def cleanup_old_files(keep_pattern=None):
    """Clean up old files in /tmp except model cache"""
    try:
        for item in os.listdir('/tmp'):
            if item.startswith('.'):  # Keep cache directories
                continue
            if keep_pattern and keep_pattern in item:  # Keep current session files
                continue

            item_path = os.path.join('/tmp', item)
            try:
                if os.path.isfile(item_path):
                    os.remove(item_path)
                    print(f"[Cleanup] Removed old file: {item}")
            except Exception as e:
                print(f"[Cleanup] Failed to remove {item}: {str(e)}")
    except Exception as e:
        print(f"[Cleanup] Error during cleanup: {str(e)}")

def lambda_handler(event, context):
    """
    Transcribe video using OpenAI Whisper

    Input event:
    {
        "session_id": "uuid",
        "s3_video_key": "session_id/original_video.mp4",
        "video_info": {...}
    }

    Output:
    {
        "session_id": "uuid",
        "s3_video_key": "...",
        "s3_transcript_key": "session_id/transcript.json",
        "video_info": {...}
    }
    """
    global model

    try:
        session_id = event['session_id']
        s3_video_key = event['s3_video_key']
        video_info = event.get('video_info', {})

        print(f"[Transcribe] Session: {session_id}")
        print(f"[Transcribe] Video: {s3_video_key}")

        # Check initial disk space
        disk = get_disk_usage()
        print(f"[Transcribe] Initial disk: {disk['free_gb']:.2f} GB free / {disk['total_gb']:.2f} GB total ({disk['percent_used']:.1f}% used)")

        # Clean up old video files from previous invocations
        cleanup_old_files(keep_pattern=session_id)

        # Check disk space after cleanup
        disk = get_disk_usage()
        print(f"[Transcribe] After cleanup: {disk['free_gb']:.2f} GB free")

        # Create cache directories if they don't exist
        os.makedirs('/tmp/.cache', exist_ok=True)
        os.makedirs('/tmp/.torch', exist_ok=True)
        os.makedirs('/tmp/.huggingface', exist_ok=True)

        # Download video from S3
        local_video_path = f"/tmp/{session_id}_video.mp4"
        print(f"[Transcribe] Downloading from S3...")

        try:
            s3.download_file(BUCKET_NAME, s3_video_key, local_video_path)
            video_size_mb = os.path.getsize(local_video_path) / (1024**2)
            print(f"[Transcribe] Video downloaded: {video_size_mb:.2f} MB")

            # Check remaining disk space
            disk = get_disk_usage()
            print(f"[Transcribe] Remaining disk: {disk['free_gb']:.2f} GB free")

            if disk['free_gb'] < 0.1:  # Less than 100 MB free
                raise Exception(f"Insufficient disk space: only {disk['free_gb']:.2f} GB free. Increase Lambda ephemeral storage.")
        except OSError as e:
            if e.errno == 28:  # No space left on device
                disk = get_disk_usage()
                raise Exception(f"Out of disk space! Total: {disk['total_gb']:.2f} GB, Used: {disk['used_gb']:.2f} GB. Increase Lambda ephemeral storage to at least 2 GB.")
            raise

        # Load Whisper model (cached on warm starts)
        if model is None:
            print(f"[Transcribe] Loading Whisper '{MODEL_SIZE}' model...")
            # Explicitly specify download_root to use /tmp
            model = whisper.load_model(MODEL_SIZE, download_root='/tmp/.cache/whisper')
            print("[Transcribe] Model loaded!")
        else:
            print("[Transcribe] Using cached model")

        # Transcribe with word-level timestamps
        print("[Transcribe] Transcribing audio...")
        result = model.transcribe(
            local_video_path,
            word_timestamps=True,
            verbose=False
        )

        # Extract segments with timestamps
        segments = []
        for segment in result.get('segments', []):
            segments.append({
                'start': segment['start'],
                'end': segment['end'],
                'text': segment['text'].strip(),
                'words': segment.get('words', [])
            })

        transcript_data = {
            'text': result['text'],
            'segments': segments,
            'language': result.get('language', 'unknown')
        }

        print(f"[Transcribe] Transcribed {len(segments)} segments")
        print(f"[Transcribe] Language: {transcript_data['language']}")

        # Upload transcript to S3
        transcript_key = f"{session_id}/transcript.json"
        print(f"[Transcribe] Uploading transcript to S3: {transcript_key}")

        s3.put_object(
            Bucket=BUCKET_NAME,
            Key=transcript_key,
            Body=json.dumps(transcript_data, ensure_ascii=False, indent=2),
            ContentType='application/json'
        )

        # Clean up local file
        os.remove(local_video_path)
        print("[Transcribe] Complete!")

        return {
            'statusCode': 200,
            'session_id': session_id,
            's3_video_key': s3_video_key,
            's3_transcript_key': transcript_key,
            'video_info': video_info
        }

    except Exception as e:
        print(f"[Transcribe] Error: {str(e)}")
        raise Exception(f"Failed to transcribe video: {str(e)}")
